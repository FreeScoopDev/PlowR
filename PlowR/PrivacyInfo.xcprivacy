<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- PlowR does not track users across apps or websites -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!--
        Data collected and transmitted to third-party servers.
        All other user data (clients, routes, proposals, photos) is stored
        exclusively in the user's own private iCloud container and is never
        transmitted to PlowR's or any third party's servers.
    -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <dict>
            <!-- Precise location is sent to api.open-meteo.com for weather
                 and api.open-topo-data.com for property elevation.
                 Coordinates are rounded to ~1 km before transmission.
                 Not linked to user identity. Not used for tracking. -->
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePreciseLocation</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>

    <!--
        Required-reason APIs used by this app.
    -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <!-- UserDefaults is used to store UI preferences (selected tab,
                 notification location toggle, role selection) and to pass
                 route-progress data to the home screen widget via App Groups. -->
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
